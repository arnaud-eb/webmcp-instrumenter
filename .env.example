# Copy to `.env` and fill in. `.env` is git-ignored — never commit real values.
#
# Keep these here, NOT in ~/.zshrc: a shell-wide ANTHROPIC_API_KEY takes
# precedence over the Claude Code subscription login (it bills API credits and
# disables claude.ai connectors). A repo-local .env is only visible to this
# project's Python process.

# Required by the `draft` stage (LLM-assisted contract drafting).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
# WEBMCP_DRAFT_MODEL=claude-sonnet-5
# WEBMCP_SINK_URL=https://<your-worker>.workers.dev
# WEBMCP_CRAWL_TIMEOUT_S=30
